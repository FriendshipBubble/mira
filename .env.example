DISCORD_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=1471581581746634959
DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/oauth/discord/callback
DISCORD_OAUTH_SCOPES=identify guilds guilds.members.read
DISCORD_ADMIN_GUILD_ID=your_server_guild_id
# Shared secret for server-to-server calls (e.g. the frontend's background
# worker) to /commands/*. Must match SERVICE_API_KEY in the frontend's .env.
SERVICE_API_KEY=generate_a_long_random_string
# Optional
# DISCORD_USER_ID=123456789012345678
# DISCORD_ALLOWED_ROLE_ID=123456789012345678
